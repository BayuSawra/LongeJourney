[background arg="res://art/backgrounds/crossroads.png" fade="0.0"]

audio action -
audio ambience -
audio ambience "res://audio/sfx/14_wind/wind_in_the_top_of_the_mountain.wav" [fade="0.5" volume="-8.0" bus="SFX" loop="true"]
[color=#696969][i]※当前位置  路口※[/i][/color] #id:lj_03_crossroads_000

路口没什么景色，人也少得很。 #id:lj_03_crossroads_001

if {visit_shiling} == 1 and {visit_luyuan} == 0:
    [background arg="res://art/backgrounds/crossroads_bus_sunflower.png" fade="0.6"]
    audio action "res://audio/sfx/25_bus_arrival/bus_coach_ext_pull_up_brake_air_release_idle.mp3" [bus="SFX" loop="false"]
    一辆公交靠边停下，邻居探出车窗，硬塞给我一枝向日葵。 #id:lj_03_crossroads_003
    audio action -
    
    “拿着，探病用的。” #id:lj_03_crossroads_004
    
    set {flower} += 1
elif {visit_shiling} == 0 and {visit_luyuan} == 1:
    [background arg="res://art/backgrounds/crossroads_bus_sunflower.png" fade="0.6"]
    audio action "res://audio/sfx/25_bus_arrival/bus_coach_ext_pull_up_brake_air_release_idle.mp3" [bus="SFX" loop="false"]
    一辆公交靠边停下，邻居探出车窗，硬塞给我一枝向日葵。 #id:lj_03_crossroads_008
    audio action -
    
    “拿着，探病用的。” #id:lj_03_crossroads_009
    
    set {flower} += 1

- 走去花店 | [if {visit_huadian} < 3] [else="disable" alt_text="花店暂时没有新的线索。"] #id:lj_03_crossroads_012
    audio action "res://audio/sfx/29_road_steps/light_footsteps_on_concrete_walking_wav.mp3" [bus="SFX" loop="false"]
    花店不远，走过去就行。 #id:lj_03_crossroads_013
    audio action -
    set {energy} -= 5
    set {visit_huadian} += 1.0
    jump 04_flower_shop/
- 乘车去狮岭（需要 2 元） | [if {money} >= 2] [else="disable" alt_text="金钱不足（需要 2 元）。"] #id:lj_03_crossroads_018
    audio action "res://audio/sfx/24_coin_payment/coin_payment.mp3" [bus="SFX" loop="false"]
    我上了去狮岭的车，付了车费。 #id:lj_03_crossroads_019
    audio action -
    set {money} -= 2
    set {visit_shiling} += 1
    jump 05_shiling/
- 乘车去露园（需要 2 元） | [if {money} >= 2] [else="disable" alt_text="金钱不足（需要 2 元）。"] #id:lj_03_crossroads_024
    audio action "res://audio/sfx/24_coin_payment/coin_payment.mp3" [bus="SFX" loop="false"]
    我上了去露园的车，付了车费。 #id:lj_03_crossroads_025
    audio action -
    set {money} -= 2
    set {visit_luyuan} += 1
    jump 06_luyuan/
- 回医院 #id:lj_03_crossroads_030
    jump 01_hospital/
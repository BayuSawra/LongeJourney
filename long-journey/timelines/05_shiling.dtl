if {visit_shiling} == 1:
    [background arg="res://art/backgrounds/shiling_foothill.png" fade="0.0"]
else:
    [background arg="res://art/backgrounds/shiling_closed_gate.png" fade="0.0"]

audio action -
audio ambience -
audio ambience "res://audio/sfx/14_wind/wind_in_the_top_of_the_mountain.wav" [loop="true", fade="0.5", volume="-8", bus="SFX"]
[color=#696969][i]※当前位置  狮岭※[/i][/color] #id:lj_05_shiling_000

if {visit_shiling} == 1:
    狮岭山脚下立着块旧碑，说王历新曾在这里凿开洞窟，里头卧着一头石狮子。 #id:lj_05_shiling_003

    - 开始搜索 #id:lj_05_shiling_004
        set {energy} -= 5
        [background arg="res://art/backgrounds/shiling_bandit_ambush.png" fade="0.6"]
        audio action "res://audio/sfx/03_footsteps/footsteps_walking_through_woods.mp3" [loop="false", bus="SFX"]
        我沿着山路往里走，刚转过一个弯，就被几个凶神恶煞的人围住了。 #id:lj_05_shiling_006
        audio action -

        “此路是我开！留下买路财！” #id:lj_05_shiling_007

        - 仔细看看他们 #id:lj_05_shiling_008
            这些人脸上糊着油彩，手里攥着塑料刀，分明是演员假扮的土匪。 #id:lj_05_shiling_009

            audio action "res://audio/sfx/11_plant_break/plant_stem_break_2.mp3" [loop="false", bus="SFX"]
            崖壁上长着一朵鸢尾花，我伸手摘了下来。 #id:lj_05_shiling_010
            audio action -
            [background arg="res://art/backgrounds/shiling_bandit_ambush_no_iris.png" fade="0.6"]

            set {flower} += 1

            - 再仔细看看那朵花 #id:lj_05_shiling_012
                花瓣是假的，塑料气味刺鼻。 #id:lj_05_shiling_013

                - 扔掉假花 #id:lj_05_shiling_014
                    我把假花丢进草丛。 #id:lj_05_shiling_015

                    set {flower} -= 1
                    set {jiahua} = false

                    - 继续搜索 #id:lj_05_shiling_018

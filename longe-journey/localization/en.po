#. source-sha256: b5e00f8a8938e3f5c0a366b8215f2eedca355ca8e78fdc191e39602f7b8ab231
msgid "Choice/lj_07_maze_right_002/text"
msgstr "Start eavesdropping"

#: res://timelines/07_maze_right.dtl:9
#. source-sha256: b9690f932dfb364070757c897b7549d281aabad21f8f0ca66f4572721824f037
msgid "Choice/lj_07_maze_right_006/text"
msgstr "Keep walking"

#: res://timelines/08_wife_room.dtl:11
#. source-sha256: 5fe8d64eac905726ecaed854a793a0b9a3bc002f83ccf381905ca073b68da96f
msgid "Choice/lj_08_wife_room_008/text"
msgstr "Open the curtain"

#: res://timelines/10_morgue.dtl:9
#. source-sha256: fbeabf73ed75abebe666a7cd999e8451a63feaac3e7c12def431dfb6de7a1296
msgid "Choice/lj_10_morgue_005/text"
msgstr "Look more closely"

#: res://timelines/10_morgue.dtl:16
#. source-sha256: 82486dd8f1c8035e8ca40bf2b94612b8a7406d2269cd75778daf8e8f7f939e5d
msgid "Choice/lj_10_morgue_010/text"
msgstr "Leave with the basket"

#: res://timelines/10_morgue.dtl:18
#. source-sha256: 572cf45ba43634b3448aadbc48d5398a1b32ad8a97bf42b689c394de222c30a1
msgid "Choice/lj_10_morgue_014/text"
msgstr "Return"

#: res://timelines/10_morgue.dtl:23
#. source-sha256: 572cf45ba43634b3448aadbc48d5398a1b32ad8a97bf42b689c394de222c30a1
msgid "Choice/lj_10_morgue_020/text"
msgstr "Return"

#: res://timelines/10_morgue.dtl:28
#. source-sha256: 572cf45ba43634b3448aadbc48d5398a1b32ad8a97bf42b689c394de222c30a1
msgid "Choice/lj_10_morgue_026/text"
msgstr "Return"

#: res://timelines/00_start.dtl:1
#. source-sha256: 8a34a2fdec3fe665eb6991e5dc761856fb8e7429e86208fb5b05e8a7283e0bc6
msgid "Text/lj_00_start_000/text"
msgstr "[color=#696969][i]※Current location: On the bus※[/i][/color]"

#: res://timelines/00_start.dtl:3
#. source-sha256: 45ac721d6c0f7151bc7e0f0b80e785f9b2b5c43718d7bbc33b4c21b97a36f8ba
msgid "Text/lj_00_start_001/text"
msgstr "Almost at the hospital. The bus turns slowly to the left, and I see its gray outer walls, ivy covering most of the building. Tattered windows spit out blue-gray curtains."

#: res://timelines/00_start.dtl:5
#. source-sha256: 968ce265d62666d7a5867dd1f4967c55413b7cf770ad988f3c16a915786167a7
msgid "Text/lj_00_start_002/text"
msgstr "It's a lousy hospital. I know that much."

#: res://timelines/00_start.dtl:7
#. source-sha256: 776041ae0f456c30197882946c88407ebefe8892acb9f4acfdcc64b4e652e5ff
msgid "Text/lj_00_start_003/text"
msgstr "My wife has been in hospital for... I forget how long. Poor thing."

#: res://timelines/00_start.dtl:9
#. source-sha256: 9c97c459a172557c9746f817bab63e937c76125188be8aca7475b38a668fc4c7
msgid "Text/lj_00_start_004/text"
msgstr "I glance at the other passengers. Every one of them sits there in grimy silence, like a nest of rats."

#: res://timelines/00_start.dtl:11
#. source-sha256: 29acddbc43a7144dc93f3fb51fd50a8b97443bb55ff1b042d1b649b5bbfb47b4
msgid "Text/lj_00_start_005/text"
msgstr "I count fifteen people besides myself. What are they all doing out in weather like this? Probably nothing better to do. Might as well wander around."

#: res://timelines/00_start.dtl:13
#. source-sha256: 13c67a1ddc93583f899b65e15753fe8f798c425f87ff6f9d46e16082a4cdfccd
msgid "Text/lj_00_start_006/text"
msgstr "Fortunately, none of them are thieves. Nothing gets past these eyes. I can tell the good from the bad with a single glance!"

#: res://timelines/00_start.dtl:15
#. source-sha256: c8f3fe8799ee04c542836716f1ad115ee77428dbba7142d5fee81971a7c51779
msgid "Text/lj_00_start_007/text"
msgstr "They're behaving themselves for now. None of them dare look me in the eye. They must know who they're dealing with. Scared, are they?"

#: res://timelines/00_start.dtl:17
#. source-sha256: 8bcd063bee8f52809bff92635dfea88aa41f5bb6c242fd08caf6aafe7c73ca06
msgid "Text/lj_00_start_008/text"
msgstr "The bus stops. Everyone turns to stare at me, hinting that it's time I got off."

#: res://timelines/01_hospital.dtl:1
#. source-sha256: c07650ad63b03fe632ad2b4b98156fbdaa78a1565d2479eb3154953e9e32d956
msgid "Text/lj_01_hospital_000/text"
msgstr "[color=#696969][i]※Current location: Hospital※[/i][/color]"

#: res://timelines/01_hospital.dtl:3
#. source-sha256: 4df2d19b50137b611ad0c44a2abc8981564de2650edf1d644fa3fdf520bc0cf2
msgid "Text/lj_01_hospital_001/text"
msgstr "Standing outside the hospital, I feel a chill. This really isn't visiting weather. What if I catch a cold? That would only make things worse."

#: res://timelines/01_hospital.dtl:5
#. source-sha256: 7997951752319c689de98d4994823634acd6caea9266f4c7f116f95937d8caaa
msgid "Text/lj_01_hospital_002/text"
msgstr "I take out my phone and check our messages: my wife is on the seventh floor of the inpatient building, bed 5-05."

#: res://timelines/02_ward.dtl:1
#. source-sha256: d1b5a6c80a11174e2645a28d05183f367a04ae17b920d0d54dd576a1d81cc83d
msgid "Text/lj_02_ward_000/text"
msgstr "[color=#696969][i]※Current location: Inpatient ward※[/i][/color]"

#: res://timelines/02_ward.dtl:3
#. source-sha256: fef0f675d90783adcd7765aebde8cabf7941c8e91795489a91a6c8c05d2ef781
msgid "Text/lj_02_ward_001/text"
msgstr "A nurse stands at the entrance to the corridor and blocks my way."

#: res://timelines/02_ward.dtl:6
#. source-sha256: 45daa0dc106063d6eacd4e6515a3244c939cda257ab841b9093a3d00a4107773
msgid "Text/lj_02_ward_003/text"
msgstr "She looks me up and down and clicks her tongue."

#: res://timelines/02_ward.dtl:8
#. source-sha256: ab4fd0955f39b3d6ed0fea9bb70286494fb6aea1d158f072e52bdbbe9f95e04a
msgid "Text/lj_02_ward_004/text"
msgstr "“No flowers, no entry.”"

#: res://timelines/02_ward.dtl:9
#. source-sha256: 1bc2495bd0fd019677667eee3d3d699ed8418506c61b1c10847e3a555cd78ced
msgid "Text/lj_02_ward_005/text"
msgstr "“I don't know you. No flowers, and still you stand here yapping. Anyone with common sense knows to bring five flowers.”"

#: res://timelines/02_ward.dtl:11
#. source-sha256: 8cca93599cbb84b935bcbd44fbbaba04e38cae6e0f12525e8ab71402f3c78c2b
msgid "Text/lj_02_ward_006/text"
msgstr "She waves me away, and I slink back downstairs."

#: res://timelines/02_ward.dtl:16
#. source-sha256: 4c11338a7a939e2663fc0d323fcaf5c314809de4bb71bb80ef99c2131daba4a6
msgid "Text/lj_02_ward_012/text"
msgstr "The nurse notices the pale yellow flower basket in my hand. Her tone softens."

#: res://timelines/02_ward.dtl:18
#. source-sha256: c85f95b8f0251baf5f4d57b3a575896c20375c5c6ff88f4af9976828e0061e02
msgid "Text/lj_02_ward_013/text"
msgstr "“Fine. Get on in, then.”"

#: res://timelines/02_ward.dtl:22
#. source-sha256: cbb76567aad234fd435101317cb0a549c8ef3d0e5f546ad0f184effc1ef2c1d4
msgid "Text/lj_02_ward_016/text"
msgstr "I walk through the dim corridor and push open the door to room 5-05 on the seventh floor. The curtain is drawn."

#: res://timelines/02_ward.dtl:24
#. source-sha256: 0ad2cd7fb915381417e2280ed0c99e39fb56c215495aef40f041a46540e21a9b
msgid "Text/lj_02_ward_017/text"
msgstr "(Next phase: connect 08_wife_room here, covering entry into the room and opening the curtain.)"

#: res://timelines/02_ward.dtl:27
#. source-sha256: 3f30537c566fa7ab389a20a0e9b9942993998c3071b38bda1fa07867f360622f
msgid "Text/lj_02_ward_022/text"
msgstr "The nurse stares at the jumble of flowers in my hands and starts scolding me."

#: res://timelines/02_ward.dtl:29
#. source-sha256: ecdb254f99170948c6595c79926cdf31cf8f5c630f55f7243ff85edd7e89aae3
msgid "Text/lj_02_ward_023/text"
msgstr "“No manners at all. You're just going to carry those flowers in a mess like that? Couldn't you buy a basket?”"

#: res://timelines/02_ward.dtl:31
#. source-sha256: a1819b7c19ad22f2f7b1bb2d70f8b86998627d2d8d91e43dda32e1ca80bdb47b
msgid "Text/lj_02_ward_024/text"
msgstr "After her tirade, she steps aside anyway."

#: res://timelines/02_ward.dtl:35
#. source-sha256: cbb76567aad234fd435101317cb0a549c8ef3d0e5f546ad0f184effc1ef2c1d4
msgid "Text/lj_02_ward_027/text"
msgstr "I walk through the dim corridor and push open the door to room 5-05 on the seventh floor. The curtain is drawn."

#: res://timelines/02_ward.dtl:37
#. source-sha256: 0ad2cd7fb915381417e2280ed0c99e39fb56c215495aef40f041a46540e21a9b
msgid "Text/lj_02_ward_028/text"
msgstr "(Next phase: connect 08_wife_room here, covering entry into the room and opening the curtain.)"

#: res://timelines/03_crossroads.dtl:1
#. source-sha256: fb2c1065f057a8f379de59a77ed1f0c8439d89e80333600bf2336b498935bc96
msgid "Text/lj_03_crossroads_000/text"
msgstr "[color=#696969][i]※Current location: Crossroads※[/i][/color]"

#: res://timelines/03_crossroads.dtl:3
#. source-sha256: 9c11e6d64e7ce1838169683ec89612c7b07ad62e4528f98b0dfc71f1d766bfe4
msgid "Text/lj_03_crossroads_001/text"
msgstr "There isn't much to see at the crossroads. Hardly anyone around, either."

#: res://timelines/03_crossroads.dtl:6
#. source-sha256: 16665d903a1f2c9f60b060eb6bae688682c3e40ae40249c4b848964a3725df7c
msgid "Text/lj_03_crossroads_003/text"
msgstr "A bus pulls over. My neighbor leans out of a window and thrusts a sunflower into my hand."

#: res://timelines/03_crossroads.dtl:8
#. source-sha256: 0a67790c18f9ac5b4451343e260db89cfe34466cbdb83a4a07d2e9910c04b26e
msgid "Text/lj_03_crossroads_004/text"
msgstr "“Here. For your hospital visit.”"

#: res://timelines/03_crossroads.dtl:12
#. source-sha256: 16665d903a1f2c9f60b060eb6bae688682c3e40ae40249c4b848964a3725df7c
msgid "Text/lj_03_crossroads_008/text"
msgstr "A bus pulls over. My neighbor leans out of a window and thrusts a sunflower into my hand."

#: res://timelines/03_crossroads.dtl:14
#. source-sha256: 0a67790c18f9ac5b4451343e260db89cfe34466cbdb83a4a07d2e9910c04b26e
msgid "Text/lj_03_crossroads_009/text"
msgstr "“Here. For your hospital visit.”"

#: res://timelines/03_crossroads.dtl:19
#. source-sha256: 69bd0a7cc88ae8ac7908450a4465288b909e6f793dac76dcf16a5d5bc2d2d2d7
msgid "Text/lj_03_crossroads_013/text"
msgstr "The flower shop isn't far. I can walk."

#: res://timelines/03_crossroads.dtl:24
#. source-sha256: 5e272b3c3c9c2db15abf57e2ae280cb1786d75e950f08ab8fd9af2df3254506a
msgid "Text/lj_03_crossroads_019/text"
msgstr "I board the bus to Lion Ridge and pay the fare."

#: res://timelines/03_crossroads.dtl:29
#. source-sha256: 8db06ac5f44c56777cf5e3def1c58daff1baa776482c787f9fff91249062d194
msgid "Text/lj_03_crossroads_025/text"
msgstr "I board the bus to Dew Garden and pay the fare."

#: res://timelines/04_flower_shop.dtl:1
#. source-sha256: d49b60c116c351ce94a42a17abaae3585e0eb35f0210260b549b9bf5af4229b1
msgid "Text/lj_04_flower_shop_000/text"
msgstr "[color=#696969][i]※Current location: Flower shop※[/i][/color]"

#: res://timelines/04_flower_shop.dtl:4
#. source-sha256: c8d2269f0ed4eefd3776095aa5bbae79cbe24af5baada435320e74ccdb62fa99
msgid "Text/lj_04_flower_shop_002/text"
msgstr "They call it a flower shop, but it's barely two square meters, with the shutter half down. The owner looks at her phone. The buckets are full of dirt."

#: res://timelines/04_flower_shop.dtl:6
#. source-sha256: 727846776ff2d65085c3d760757de682451048f8ff26bfbede330569754e10fa
msgid "Text/lj_04_flower_shop_003/text"
msgstr "“No more flowers. I'm raising toads now.”"

#: res://timelines/04_flower_shop.dtl:9
#. source-sha256: 14085b0e6a8639ac1dc03dc8eefa8556eed6d89be0e12403b6cefc8c8f163e4c
msgid "Text/lj_04_flower_shop_005/text"
msgstr "I kick the bucket over, spilling dirt across the floor."

#: res://timelines/04_flower_shop.dtl:11
#. source-sha256: 0f2344b525f918f13bc6227513ca2a5aa90c0a90b69437b68487c9c5824edc90
msgid "Text/lj_04_flower_shop_006/text"
msgstr "The owner freezes for a moment. Strangely, she doesn't get angry. The corners of her mouth even curl upward."

#: res://timelines/04_flower_shop.dtl:16
#. source-sha256: 7f692b3fbc2958ec4d10f4c62ac0121e134395933b3bc060f30e97325ffed6ef
msgid "Text/lj_04_flower_shop_011/text"
msgstr "She raises her head, slowly fishes an earthworm out of the bucket, and holds it out to me."

#: res://timelines/04_flower_shop.dtl:18
#. source-sha256: bd294f529cdb88a2eb07d40e6276f3fd19eca93944b5d0f0c179088911221b52
msgid "Text/lj_04_flower_shop_012/text"
msgstr "“Then you must want this, too.”"

#: res://timelines/04_flower_shop.dtl:21
#. source-sha256: 2d10ae6ec227b2cf2fc47037b7d68a15872ebc56c999a46ea4cb2dced996e66c
msgid "Text/lj_04_flower_shop_014/text"
msgstr "I pinch the slippery earthworm between my fingers, a creeping unease in my chest."

#: res://timelines/04_flower_shop.dtl:27
#. source-sha256: e8aaf9c5feea09c020ff193d5c16a81745229968081afb5986cc31fb076e8495
msgid "Text/lj_04_flower_shop_020/text"
msgstr "“Like I'd want that.”"

#: res://timelines/04_flower_shop.dtl:31
#. source-sha256: 0e8e77ed5c2d9a553dffe458b999a8ae0902c94c757eb3259b07fdcca28ff6c2
msgid "Text/lj_04_flower_shop_026/text"
msgstr "The shop is closing. Head down, the owner pulls the shutter lower."

#: res://timelines/04_flower_shop.dtl:33
#. source-sha256: 6d18434e749ffd5f3ef617102436218dd4a8f7c04eac1189bcc6055b26ecc6b9
msgid "Text/lj_04_flower_shop_027/text"
msgstr "I don't go near it. One look from a distance, and I turn away."

#: res://timelines/04_flower_shop.dtl:38
#. source-sha256: aefe7f4a5bbe9da3d8c16ca2699aa49fd2902bfdd00a88aacf26d0ebbf7369c7
msgid "Text/lj_04_flower_shop_033/text"
msgstr "The flower shop is closed, its shutter pulled tight."

#: res://timelines/05_shiling.dtl:1
#. source-sha256: 6c878fd92f85d9f14872bedec04732cb28e506f7083d5eb2c1c2d46af6e1a5b4
msgid "Text/lj_05_shiling_000/text"
msgstr "[color=#696969][i]※Current location: Lion Ridge※[/i][/color]"

#: res://timelines/05_shiling.dtl:5
#. source-sha256: cc5baccb7084a4a6fdd05e875041aaed208c9ff2ceb38c0280377ae4f538c1c9
msgid "Text/lj_05_shiling_003/text"
msgstr "An old stele at the foot of Lion Ridge says that Wang Lixin once carved out a cave here. Inside lies a stone lion."

#: res://timelines/05_shiling.dtl:9
#. source-sha256: c7c4e8c9a57e31865ad075d1c7ec1fa746bb0df2d06dd46de35ad0287e5c8661
msgid "Text/lj_05_shiling_006/text"
msgstr "I follow the mountain path. Around the first bend, a group of vicious-looking people surrounds me."

#: res://timelines/05_shiling.dtl:11
#. source-sha256: 651e162623977c24b8c2788ae23783bf88c1a7d16efd5c26883437b60039ff50
msgid "Text/lj_05_shiling_007/text"
msgstr "“This is our road! Pay the toll!”"

#: res://timelines/05_shiling.dtl:14
#. source-sha256: 13652af47f33d529f94047aa29f40adda53cd8d1a9eea6aecc5f27ab40f944e2
msgid "Text/lj_05_shiling_009/text"
msgstr "Greasepaint cakes their faces, and plastic swords hang at their waists. They're obviously actors playing bandits."

#: res://timelines/05_shiling.dtl:16
#. source-sha256: b0c5313a537a7264179fe7a4beb711d0ad55fd252465e57c6522da8d009d5440
msgid "Text/lj_05_shiling_010/text"
msgstr "An iris grows on the cliff face. I reach out and pick it."

#: res://timelines/05_shiling.dtl:21
#. source-sha256: 5fa61277d1adeb8097e5a00c4b23900ffbd0c3daba50102225afe68e88b7969e
msgid "Text/lj_05_shiling_013/text"
msgstr "The petals are fake. The smell of plastic is sharp in my nose."

#: res://timelines/05_shiling.dtl:24
#. source-sha256: 53fa5453171f2302b9d4889d8b91f578ea4f46233cccf03311773c0325ed8933
msgid "Text/lj_05_shiling_015/text"
msgstr "I toss the fake flower into the grass."

#: res://timelines/05_shiling.dtl:31
#. source-sha256: ade8cf68cd7faa5c39bf6ad61cfbcb2f24701d3a4be7f4ca73249122299174fe
msgid "Text/lj_05_shiling_020/text"
msgstr "An iron lion crouches in the clearing ahead, spitting a stream of fire."

#: res://timelines/05_shiling.dtl:35
#. source-sha256: d76e56c4b63d8717ba2821534fe970fc24e74598918f5b7f115c776ab541342f
msgid "Text/lj_05_shiling_023/text"
msgstr "The farther I go, the more wrong it feels. The mountain is burning. Human shapes glow red."

#: res://timelines/05_shiling.dtl:38
#. source-sha256: 5e4bd33fe4b5a33440bc438f81ca77cb690a64979575b57ded5fb00479f7f45a
msgid "Text/lj_05_shiling_025/text"
msgstr "An offering table stands before the White Jade Lion Temple. A single peony sits on it."

#: res://timelines/05_shiling.dtl:41
#. source-sha256: aa6444ce1f37bca24bcea0cca104b0f92e3865acfef16a0b9868705c32c4fd20
msgid "Text/lj_05_shiling_027/text"
msgstr "I grab the peony and pull it out. My hand trembles. The stem is caked with mud."

#: res://timelines/05_shiling.dtl:48
#. source-sha256: c7b1f04aef1fd3dca11b19deee2d0ba353d17c6b4b25525a1111dc7c74d37cc2
msgid "Text/lj_05_shiling_032/text"
msgstr "I now have {flower} flowers in total."

#: res://timelines/05_shiling.dtl:50
#. source-sha256: 2839a0518def10fd6f6279ab9be235a3439b8012f62ccf444a7909832883c564
msgid "Text/lj_05_shiling_033/text"
msgstr "I retrace my steps and pay two yuan for the bus back to the crossroads."

#: res://timelines/05_shiling.dtl:55
#. source-sha256: a04dcba0df1317d152278fda2bc91ec19df41551af80b284c9be19bca70e23b4
msgid "Text/lj_05_shiling_038/text"
msgstr "I leave the peony untouched, turn around, and head back the way I came."

#: res://timelines/05_shiling.dtl:57
#. source-sha256: c7b1f04aef1fd3dca11b19deee2d0ba353d17c6b4b25525a1111dc7c74d37cc2
msgid "Text/lj_05_shiling_039/text"
msgstr "I now have {flower} flowers in total."

#: res://timelines/05_shiling.dtl:59
#. source-sha256: 5410faca0e8f88efba0ffe0594df9f780d9273ac3fabcf78e3058bdfeb75cfd1
msgid "Text/lj_05_shiling_040/text"
msgstr "I pay two yuan for the bus back to the crossroads."

#: res://timelines/05_shiling.dtl:64
#. source-sha256: c7b1f04aef1fd3dca11b19deee2d0ba353d17c6b4b25525a1111dc7c74d37cc2
msgid "Text/lj_05_shiling_045/text"
msgstr "I now have {flower} flowers in total."

#: res://timelines/05_shiling.dtl:66
#. source-sha256: 5410faca0e8f88efba0ffe0594df9f780d9273ac3fabcf78e3058bdfeb75cfd1
msgid "Text/lj_05_shiling_046/text"
msgstr "I pay two yuan for the bus back to the crossroads."

#: res://timelines/05_shiling.dtl:71
#. source-sha256: c7b1f04aef1fd3dca11b19deee2d0ba353d17c6b4b25525a1111dc7c74d37cc2
msgid "Text/lj_05_shiling_052/text"
msgstr "I now have {flower} flowers in total."

#: res://timelines/05_shiling.dtl:73
#. source-sha256: 5410faca0e8f88efba0ffe0594df9f780d9273ac3fabcf78e3058bdfeb75cfd1
msgid "Text/lj_05_shiling_053/text"
msgstr "I pay two yuan for the bus back to the crossroads."

#: res://timelines/05_shiling.dtl:78
#. source-sha256: c7b1f04aef1fd3dca11b19deee2d0ba353d17c6b4b25525a1111dc7c74d37cc2
msgid "Text/lj_05_shiling_059/text"
msgstr "I now have {flower} flowers in total."

#: res://timelines/05_shiling.dtl:80
#. source-sha256: 5410faca0e8f88efba0ffe0594df9f780d9273ac3fabcf78e3058bdfeb75cfd1
msgid "Text/lj_05_shiling_060/text"
msgstr "I pay two yuan for the bus back to the crossroads."

#: res://timelines/05_shiling.dtl:87
#. source-sha256: ade8cf68cd7faa5c39bf6ad61cfbcb2f24701d3a4be7f4ca73249122299174fe
msgid "Text/lj_05_shiling_068/text"

#: res://timelines/06_luyuan.dtl:1
#. source-sha256: e00675192b4a68ca035d6acdfb549aa72c374cc2e18b85b35f18d1c2771eab1b
msgid "Text/lj_06_luyuan_000/text"
msgstr "[color=#696969][i]※Current location: Dew Garden※[/i][/color]"

#: res://timelines/06_luyuan.dtl:4
#. source-sha256: 9b02e8dfa31cfdfc01bca6c44e9c5dea2a5196049825172f3e3a13b5513b4d34
msgid "Text/lj_06_luyuan_002/text"
msgstr "Dew Garden is eight hundred years old, supposedly built by the Prince of Hailin. Admission costs four yuan. I feel in my pocket and go in anyway."

#: res://timelines/06_luyuan.dtl:7
#. source-sha256: 601f556ff77c05d7c4b477e4053931dc890d818e2bb0a4872fcd54ed4a5ca9be
msgid "Text/lj_06_luyuan_004/text"
msgstr "A white jade chrysanthemum blooms in the flower bed to the left. I pick it."

#: res://timelines/06_luyuan.dtl:11
#. source-sha256: cb90809b5abeb742bea4313403acb8e206e246fdee7a590b5848a1b0340dbed9
msgid "Text/lj_06_luyuan_006/text"
msgstr "Farther in, the path grows narrower and narrower. My own footsteps echo off the walls."

#: res://timelines/06_luyuan.dtl:14
#. source-sha256: 0d9d833576f1bbb84fdb3332629b5f3bffdf7800a7e3e58d856b1cbc68601eb5
msgid "Text/lj_06_luyuan_008/text"
msgstr "A figure stands at the center of the maze."

#: res://timelines/06_luyuan.dtl:16
#. source-sha256: d75465af12ad1e2b029b77d7cbf2e0393aee2b007aaf9d116fb998430f69ae23
msgid "Text/lj_06_luyuan_009/text"
msgstr "A woman in sumptuous robes, propped upright on a pole. Fine thread stitches her eyelids to her eyebrows. Talismans are painted on the backs of her hands."

#: res://timelines/06_luyuan.dtl:19
#. source-sha256: 9e9485ba76f5fd152985ffce2f3cd88d3f0358aa4325ef5a90719c96f4192e36
msgid "Text/lj_06_luyuan_011/text"
msgstr "I can't bear to look. I turn and run all the way out of Dew Garden."

#: res://timelines/06_luyuan.dtl:24
#. source-sha256: 74244fee8097c086a14fbacfea3147bff4314668b0450aa9d0dfc123dcbe0935
msgid "Text/lj_06_luyuan_016/text"
msgstr "I pry open her fingers and take the hydrangea. Her eyelids twitch."

#: res://timelines/06_luyuan.dtl:29
#. source-sha256: f489b1bdec789274e39b13267b27371f3adf51304585478b054f8ca3f7d17554
msgid "Text/lj_06_luyuan_019/text"
msgstr "I race out of Dew Garden."


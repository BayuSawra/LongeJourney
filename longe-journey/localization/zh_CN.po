#: res://timelines/06_luyuan.dtl:61
msgid "Text/lj_06_luyuan_048/text"
msgstr "右边石头缝里长着一棵仙人球花，我小心地摘了下来。"

#: res://timelines/06_luyuan.dtl:65
msgid "Text/lj_06_luyuan_050/text"

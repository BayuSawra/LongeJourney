if {visit_huadian} == 1 or {visit_huadian} == 2:
    [background arg="res://art/backgrounds/flower_shop_open.png" fade="0.0"]
else:
    [background arg="res://art/backgrounds/flower_shop_closed.png" fade="0.0"]

audio action -
audio ambience -
audio ambience "res://audio/sfx/14_wind/wind_in_the_top_of_the_mountain.wav" [loop="true", fade="0.5", volume="-8", bus="SFX"]
Text/lj_04_flower_shop_000/text #id:lj_04_flower_shop_000

if {visit_huadian} == 1:
    Text/lj_04_flower_shop_002/text #id:lj_04_flower_shop_002

    Text/lj_04_flower_shop_003/text #id:lj_04_flower_shop_003

    - Choice/lj_04_flower_shop_004/text #id:lj_04_flower_shop_004
        [background arg="res://art/backgrounds/flower_shop_interior_buckets.png" fade="0.6"]
        Text/lj_04_flower_shop_005/text #id:lj_04_flower_shop_005

        Text/lj_04_flower_shop_006/text #id:lj_04_flower_shop_006

        set {earthworm} += 1
        jump 03_crossroads/
    - Choice/lj_04_flower_shop_010/text #id:lj_04_flower_shop_010
        [background arg="res://art/backgrounds/flower_shop_open_offering.png" fade="0.6"]
        Text/lj_04_flower_shop_011/text #id:lj_04_flower_shop_011

        Text/lj_04_flower_shop_012/text #id:lj_04_flower_shop_012

        - Choice/lj_04_flower_shop_013/text #id:lj_04_flower_shop_013
            Text/lj_04_flower_shop_014/text #id:lj_04_flower_shop_014

            set {earthworm} += 1
            set {calm} -= 10
            jump 03_crossroads/
        - Choice/lj_04_flower_shop_019/text #id:lj_04_flower_shop_019
            Text/lj_04_flower_shop_020/text #id:lj_04_flower_shop_020

            jump 03_crossroads/
elif {visit_huadian} == 2:
    [background arg="res://art/backgrounds/flower_shop_closed.png" fade="0.6"]

    Text/lj_04_flower_shop_026/text #id:lj_04_flower_shop_026

    Text/lj_04_flower_shop_027/text #id:lj_04_flower_shop_027

    - Choice/lj_04_flower_shop_028/text #id:lj_04_flower_shop_028
        jump 03_crossroads/
else:
    Text/lj_04_flower_shop_033/text #id:lj_04_flower_shop_033

    - Choice/lj_04_flower_shop_034/text #id:lj_04_flower_shop_034
        jump 03_crossroads/

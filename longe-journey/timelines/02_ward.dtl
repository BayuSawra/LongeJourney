[background arg="res://art/backgrounds/ward_corridor.png" fade="0.0"]

audio action -
audio ambience -
audio ambience "res://audio/sfx/20_hospital_hum/a_c_hum.mp3" [loop="true", fade="0.5", volume="-8", bus="SFX"]
Text/lj_02_ward_000/text #id:lj_02_ward_000

Text/lj_02_ward_001/text #id:lj_02_ward_001

if {flower} < 5:
    Text/lj_02_ward_003/text #id:lj_02_ward_003
    
    Text/lj_02_ward_004/text #id:lj_02_ward_004
    Text/lj_02_ward_005/text #id:lj_02_ward_005
    
    [background arg="res://art/backgrounds/hospital_exterior.png" fade="0.6"]

    Text/lj_02_ward_006/text #id:lj_02_ward_006
    
    - Choice/lj_02_ward_007/text #id:lj_02_ward_007
        jump 01_hospital/
elif {hualan}:
    Text/lj_02_ward_012/text #id:lj_02_ward_012
    
    Text/lj_02_ward_013/text #id:lj_02_ward_013
    
    - Choice/lj_02_ward_014/text #id:lj_02_ward_014
        [save slot="auto"]
        [background arg="res://art/backgrounds/hospital_ward_door_505.png" fade="0.6"]
        Text/lj_02_ward_016/text #id:lj_02_ward_016
        [background arg="res://art/backgrounds/wife_room_curtained.png" fade="0.6"]
        Text/lj_02_ward_017/text #id:lj_02_ward_017
        jump 08_wife_room/
else:
    Text/lj_02_ward_022/text #id:lj_02_ward_022
    
    Text/lj_02_ward_023/text #id:lj_02_ward_023
    
    Text/lj_02_ward_024/text #id:lj_02_ward_024
    
    - Choice/lj_02_ward_025/text #id:lj_02_ward_025
        [save slot="auto"]
        [background arg="res://art/backgrounds/hospital_ward_door_505.png" fade="0.6"]
        Text/lj_02_ward_027/text #id:lj_02_ward_027
        [background arg="res://art/backgrounds/wife_room_curtained.png" fade="0.6"]
        Text/lj_02_ward_028/text #id:lj_02_ward_028
        jump 08_wife_room/

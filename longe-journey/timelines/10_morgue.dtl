if {visit_ting_shifang} >= 2:
    [background arg="res://art/backgrounds/morgue_empty.png" fade="0.0"]
else:
    [background arg="res://art/backgrounds/morgue_occupied.png" fade="0.0"]

Text/lj_10_morgue_000/text #id:lj_10_morgue_000
set {visit_ting_shifang} += 1

if {visit_ting_shifang} == 1:
    Text/lj_10_morgue_003/text #id:lj_10_morgue_003
    
    [background arg="res://art/backgrounds/morgue_interior_drawers.png" fade="0.6"]
    Text/lj_10_morgue_004/text #id:lj_10_morgue_004
    
    - Choice/lj_10_morgue_005/text #id:lj_10_morgue_005
        #set {energy} -= 5#int类型数值写法
        Text/lj_10_morgue_007/text #id:lj_10_morgue_007
        
        Text/lj_10_morgue_008/text #id:lj_10_morgue_008
        set {hualan} = true
        
        - Choice/lj_10_morgue_010/text #id:lj_10_morgue_010
            jump 01_hospital/
    - Choice/lj_10_morgue_014/text #id:lj_10_morgue_014
        jump 01_hospital/
elif {visit_ting_shifang} == 2:
    Text/lj_10_morgue_019/text #id:lj_10_morgue_019
    
    - Choice/lj_10_morgue_020/text #id:lj_10_morgue_020
        jump 01_hospital/
else:
    Text/lj_10_morgue_025/text #id:lj_10_morgue_025
    
    - Choice/lj_10_morgue_026/text #id:lj_10_morgue_026
        jump 01_hospital/

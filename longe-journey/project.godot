"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="LongeJourney"

[editor]

import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_dotnet_mcp/plugin.cfg", "res://addons/longe_lore_tools/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")


"07_maze_right": "res://timelines/07_maze_right.dtl",
"08_wife_room": "res://timelines/08_wife_room.dtl",
"09_ending": "res://timelines/09_ending.dtl",
"10_morgue": "res://timelines/10_morgue.dtl",
"timeline1_0": "res://timelines/timeline1_0.dtl"
}
layout/style_directory={
"": "res://chat_style.tres",
"chat_style": "res://chat_style.tres"
}
layout/style_list=["res://chat_style.tres"]
layout/default_style="res://chat_style.tres"
glossary/default_case_sensitive=true

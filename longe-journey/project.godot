layout/style_directory={
"": "res://chat_styel.tres",
"chat_styel": "res://chat_styel.tres"
}
layout/style_list=["res://chat_styel.tres"]
layout/default_style="res://chat_styel.tres"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="LongeJourney"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_dotnet_mcp/plugin.cfg", "res://addons/longe_lore_tools/plugin.cfg")


; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LongeJourney"
run/main_scene="uid://bkf4gxk37jjlr"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
MCPRuntimeBridge="*uid://wk2yhw3winuo"
GameState="*res://scripts/autoload/game_state.gd"
EndingManager="*res://scripts/autoload/ending_manager.gd"

[dialogic]

variables={
"calm": 100,
"earthworm": 0,
"energy": 100,
"flower": 0,
"hualan": false,
"jiahua": false,
"money": 20,
"player_name": "无名王",
"visit_huadian": 0,
"visit_luyuan": 0,
"visit_shiling": 0,
"visit_ting_shifang": 0,
"wife": 0
}
directories/dch_directory={
"我": "res://character/我.dch"
}
directories/dtl_directory={
"00_start": "res://timelines/00_start.dtl",
"01_hospital": "res://timelines/01_hospital.dtl",

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LongeJourney"
run/main_scene="res://scenes/mianMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
MCPRuntimeBridge="*res://addons/godot_dotnet_mcp/plugin/runtime/mcp_runtime_bridge.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
EndingManager="*res://scripts/autoload/ending_manager.gd"
VisualFX="*res://scripts/autoload/visual_fx.gd"
AutoSaveManager="*res://scripts/autoload/auto_save_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
LoreRuntime="*res://scripts/autoload/lore_runtime.gd"

[dialogic]

variables={
"calm": 100,
"earthworm": 0,
"energy": 100,
"flower": 0,
"hualan": false,
"jiahua": false,
"money": 20,
"player_name": "无名王",

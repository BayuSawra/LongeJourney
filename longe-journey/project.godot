config_version=5

[application]

config/name="LongeJourney"
run/main_scene="uid://bh5m0e3274r56"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
MCPRuntimeBridge="*uid://wk2yhw3winuo"

[dialogic]

directories/dch_directory={
"我": "res://character/我.dch"
}
directories/dtl_directory={
"timeline1_0": "res://timelines/timeline1_0.dtl"
}
layout/style_directory={
"": "res://chat_styel.tres",
"chat_styel": "res://chat_styel.tres"
}
layout/style_list=["res://chat_styel.tres"]
layout/default_style="res://chat_styel.tres"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="LongeJourney"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_dotnet_mcp/plugin.cfg")

